# zlib as a shared library, for packaged programs (the base system has its own copies built in)
name     = zlib
version  = 1.3.2-1
summary  = the zlib compression library (shared)
source   = https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.xz
sha256   = d7a0654783a4da529d1bb793b7ad9c3318020af77667bcae35f95d0e42a792f3
build    = CHOST=$HOST CFLAGS="-O2 -fPIC" LDSHARED="$CC -shared -Wl,-soname,libz.so.1" ./configure --prefix=$PREFIX --shared
           make -j$JOBS
install  = make install DESTDIR=$DESTDIR
