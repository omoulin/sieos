@@ -0,0 +1,312 @@
+/*
+ * Copyright © 2026 Olivier Moulin
+ * SPDX-License-Identifier: MIT
+ *
+ * EGL on SIEOS's Facet desktop: window surfaces are Facet windows
+ * (EGLNativeWindowType: a fct_window *, from libfacet's fct_window_create).
+ * Rendering is software (llvmpipe, through the swrast loader): each frame
+ * the driver presents (eglSwapBuffers) is copied into the window's buffer,
+ * 32-bit XRGB as Facet keeps it (the B8G8R8X8 / B8G8R8A8 configs), and that
+ * part of the window is shown (fct_window_damage).  The surface follows the
+ * window's size: the driver asks it at every frame (getDrawableInfo).
+ * Pbuffers are in memory (egl_dri2.c's swrast pbuffer loader).
+ *
+ * The program keeps its window and reads its events (fct_next_event) as
+ * any Facet program does; EGL only draws into it.  The native display is
+ * EGL_DEFAULT_DISPLAY (or the program's fct_display *: not used, the
+ * windows say which desktop they are on).
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <facet/facet.h>
+#include <facet/gfx.h>
+
+#include "egl_dri2.h"
+#include "eglglobals.h"
+#include "loader.h"
+#include "dri_util.h"
+#include "dri_screen.h"
+
+static bool
+facet_is_window(struct dri2_egl_surface *dri2_surf)
+{
+   return dri2_surf->base.Type == EGL_WINDOW_BIT && dri2_surf->facet_window;
+}
+
+static void
+facet_get_drawable_info(struct dri_drawable *draw, int *x, int *y, int *w,
+                        int *h, void *loaderPrivate)
+{
+   struct dri2_egl_surface *dri2_surf = loaderPrivate;
+
+   *x = *y = 0;
+   if (facet_is_window(dri2_surf)) {
+      fct_window_size(dri2_surf->facet_window, w, h);
+      dri2_surf->base.Width = *w;
+      dri2_surf->base.Height = *h;
+   } else {
+      *w = dri2_surf->base.Width;
+      *h = dri2_surf->base.Height;
+   }
+}
+
+static void
+facet_put_image2(struct dri_drawable *draw, int op, int x, int y, int w, int h,
+                 int stride, char *data, void *loaderPrivate)
+{
+   struct dri2_egl_surface *dri2_surf = loaderPrivate;
+
+   if (!facet_is_window(dri2_surf)) {
+      swrast_pbuffer_loader_extension.putImage(draw, op, x, y, w, h, data,
+                                               loaderPrivate);
+      return;
+   }
+   if (op != __DRI_SWRAST_IMAGE_OP_DRAW && op != __DRI_SWRAST_IMAGE_OP_SWAP)
+      return;
+
+   struct surface *s = fct_window_surface(dri2_surf->facet_window);
+   if (!s || !s->px)
+      return;
+   /* the window may have shrunk since the frame was drawn: clip */
+   if (x < 0 || y < 0 || x >= s->w || y >= s->h)
+      return;
+   if (x + w > s->w)
+      w = s->w - x;
+   if (y + h > s->h)
+      h = s->h - y;
+   for (int i = 0; i < h; i++)
+      memcpy(s->px + (size_t)(y + i) * s->stride + x, data + (size_t)i * stride,
+             (size_t)w * 4);
+   fct_window_damage(dri2_surf->facet_window, (struct rect){ x, y, w, h });
+}
+
+static void
+facet_put_image(struct dri_drawable *draw, int op, int x, int y, int w, int h,
+                char *data, void *loaderPrivate)
+{
+   facet_put_image2(draw, op, x, y, w, h, w * 4, data, loaderPrivate);
+}
+
+static void
+facet_get_image2(struct dri_drawable *read, int x, int y, int w, int h,
+                 int stride, char *data, void *loaderPrivate)
+{
+   struct dri2_egl_surface *dri2_surf = loaderPrivate;
+
+   if (!facet_is_window(dri2_surf)) {
+      swrast_pbuffer_loader_extension.getImage(read, x, y, w, h, data,
+                                               loaderPrivate);
+      return;
+   }
+   struct surface *s = fct_window_surface(dri2_surf->facet_window);
+   for (int i = 0; i < h; i++) {
+      char *dst = data + (size_t)i * stride;
+      if (!s || !s->px || y + i < 0 || y + i >= s->h || x < 0 || x >= s->w) {
+         memset(dst, 0, (size_t)w * 4);
+         continue;
+      }
+      int n = x + w > s->w ? s->w - x : w;
+      memcpy(dst, s->px + (size_t)(y + i) * s->stride + x, (size_t)n * 4);
+      if (n < w)
+         memset(dst + (size_t)n * 4, 0, (size_t)(w - n) * 4);
+   }
+}
+
+static void
+facet_get_image(struct dri_drawable *read, int x, int y, int w, int h,
+                char *data, void *loaderPrivate)
+{
+   facet_get_image2(read, x, y, w, h, w * 4, data, loaderPrivate);
+}
+
+static const __DRIswrastLoaderExtension facet_swrast_loader_extension = {
+   .base = {__DRI_SWRAST_LOADER, 2},
+   .getDrawableInfo = facet_get_drawable_info,
+   .putImage = facet_put_image,
+   .getImage = facet_get_image,
+   .putImage2 = facet_put_image2,
+   .getImage2 = facet_get_image2,
+};
+
+static const __DRIextension *facet_loader_extensions[] = {
+   &facet_swrast_loader_extension.base,
+   &image_lookup_extension.base,
+   NULL,
+};
+
+static _EGLSurface *
+facet_create_surface(_EGLDisplay *disp, EGLint type, _EGLConfig *conf,
+                     void *native_window, const EGLint *attrib_list)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   struct dri2_egl_config *dri2_conf = dri2_egl_config(conf);
+   struct dri2_egl_surface *dri2_surf;
+   const struct dri_config *config;
+
+   dri2_surf = calloc(1, sizeof *dri2_surf);
+   if (!dri2_surf) {
+      _eglError(EGL_BAD_ALLOC, "facet: create surface");
+      return NULL;
+   }
+
+   if (!dri2_init_surface(&dri2_surf->base, disp, type, conf, attrib_list,
+                          false, native_window))
+      goto cleanup;
+
+   if (type == EGL_WINDOW_BIT) {
+      if (!native_window) {
+         _eglError(EGL_BAD_NATIVE_WINDOW, "facet: no window");
+         goto cleanup;
+      }
+      dri2_surf->facet_window = native_window;
+      int w = 0, h = 0;
+      fct_window_size(dri2_surf->facet_window, &w, &h);
+      dri2_surf->base.Width = w;
+      dri2_surf->base.Height = h;
+   }
+
+   config = dri2_get_dri_config(dri2_conf, type, dri2_surf->base.GLColorspace);
+   if (!config) {
+      _eglError(EGL_BAD_MATCH, "facet: unsupported surface type or colorspace");
+      goto cleanup;
+   }
+
+   if (!dri2_create_drawable(dri2_dpy, config, dri2_surf, dri2_surf))
+      goto cleanup;
+
+   return &dri2_surf->base;
+
+cleanup:
+   free(dri2_surf);
+   return NULL;
+}
+
+static _EGLSurface *
+facet_create_window_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                            void *native_window, const EGLint *attrib_list)
+{
+   _EGLSurface *surf = facet_create_surface(disp, EGL_WINDOW_BIT, conf,
+                                            native_window, attrib_list);
+   if (surf)
+      surf->SwapInterval = 0;   /* (no vertical blank to wait for) */
+   return surf;
+}
+
+static _EGLSurface *
+facet_create_pbuffer_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                             const EGLint *attrib_list)
+{
+   return facet_create_surface(disp, EGL_PBUFFER_BIT, conf, NULL, attrib_list);
+}
+
+static EGLBoolean
+facet_destroy_surface(_EGLDisplay *disp, _EGLSurface *surf)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   driDestroyDrawable(dri2_surf->dri_drawable);
+   free(dri2_surf->swrast_device_buffer);
+   dri2_fini_surface(surf);
+   free(dri2_surf);
+   return EGL_TRUE;
+}
+
+static EGLBoolean
+facet_swap_buffers(_EGLDisplay *disp, _EGLSurface *draw)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(draw);
+
+   if (draw->Type != EGL_WINDOW_BIT)
+      return EGL_TRUE;
+   driSwapBuffers(dri2_surf->dri_drawable);   /* (the driver presents: putImage) */
+   return EGL_TRUE;
+}
+
+static EGLint
+facet_query_buffer_age(_EGLDisplay *disp, _EGLSurface *surf)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   return driSWRastQueryBufferAge(dri2_surf->dri_drawable);
+}
+
+static EGLBoolean
+facet_swap_interval(_EGLDisplay *disp, _EGLSurface *surf, EGLint interval)
+{
+   return EGL_TRUE;   /* (frames are shown as they come) */
+}
+
+static const struct dri2_egl_display_vtbl facet_display_vtbl = {
+   .create_window_surface = facet_create_window_surface,
+   .create_pbuffer_surface = facet_create_pbuffer_surface,
+   .destroy_surface = facet_destroy_surface,
+   .create_image = dri2_create_image_khr,
+   .swap_interval = facet_swap_interval,
+   .swap_buffers = facet_swap_buffers,
+   .query_buffer_age = facet_query_buffer_age,
+   .get_dri_drawable = dri2_surface_get_dri_drawable,
+};
+
+/* Configs for windows and pbuffers: the formats a Facet window keeps (XRGB, ARGB). */
+static void
+facet_add_configs(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   unsigned count = 0;
+
+   for (unsigned i = 0; dri2_dpy->driver_configs[i] != NULL; i++) {
+      const struct gl_config *gl_config =
+         (const struct gl_config *)dri2_dpy->driver_configs[i];
+      EGLint surface_type = EGL_PBUFFER_BIT;
+
+      if (gl_config->color_format == PIPE_FORMAT_B8G8R8X8_UNORM ||
+          gl_config->color_format == PIPE_FORMAT_B8G8R8A8_UNORM)
+         surface_type |= EGL_WINDOW_BIT;
+      else if (gl_config->color_format != PIPE_FORMAT_R8G8B8A8_UNORM &&
+               gl_config->color_format != PIPE_FORMAT_R8G8B8X8_UNORM &&
+               gl_config->color_format != PIPE_FORMAT_B5G6R5_UNORM)
+         continue;
+
+      if (dri2_add_config(disp, dri2_dpy->driver_configs[i], surface_type, NULL))
+         count++;
+   }
+   if (!count)
+      _eglLog(_EGL_WARNING, "facet: no usable config");
+}
+
+EGLBoolean
+dri2_initialize_facet(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   struct _egl_device *device;
+
+   dri2_dpy->fd_render_gpu = -1;
+   dri2_dpy->fd_display_gpu = -1;
+   device = _eglFindDevice(-1, true);   /* (the software device) */
+   if (!device)
+      return _eglError(EGL_NOT_INITIALIZED, "facet: no software device");
+   disp->Device = device;
+
+   dri2_dpy->driver_name = strdup("swrast");
+   if (!dri2_dpy->driver_name)
+      return _eglError(EGL_BAD_ALLOC, "facet");
+   dri2_detect_swrast_kopper(disp);   /* (swrast, not KMS: a DRI_SCREEN_SWRAST screen) */
+   dri2_dpy->loader_extensions = facet_loader_extensions;
+
+   if (!dri2_create_screen(disp))
+      return _eglError(EGL_NOT_INITIALIZED, "facet: cannot create the screen");
+
+   dri2_setup_screen(disp);
+   facet_add_configs(disp);
+
+   disp->Extensions.EXT_buffer_age = EGL_TRUE;
+   disp->Extensions.EXT_swap_buffers_with_damage = EGL_FALSE;
+
+   /* Fill vtbl last to prevent accidentally calling virtual function during
+    * initialization.
+    */
+   dri2_dpy->vtbl = &facet_display_vtbl;
+   return EGL_TRUE;
+}
