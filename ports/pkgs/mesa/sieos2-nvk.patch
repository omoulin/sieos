@@ -0,0 +1,154 @@
+/*
+ * Copyright © 2026 Olivier Moulin
+ * SPDX-License-Identifier: MIT
+ *
+ * libelf.c - SIEOS: libelf's read-only interface over an ELF64 image in
+ * memory, as NVK's cubin reader uses it (no libelf on SIEOS).  A section
+ * is its index; its data is the image's bytes (no conversion: the cubins
+ * are little-endian ELF64, as the processor).
+ */
+#include "libelf.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+struct Elf_Scn {
+   Elf *elf;
+   size_t index;
+   Elf_Data data;
+};
+
+struct Elf {
+   char *image;
+   size_t size;
+   Elf64_Ehdr *ehdr;
+   Elf64_Shdr *shdrs;
+   size_t nscn;
+   Elf_Scn *scns;
+};
+
+static int last_error;
+
+unsigned int
+elf_version(unsigned int version)
+{
+   return version == EV_NONE ? EV_CURRENT : version == EV_CURRENT ? EV_CURRENT : EV_NONE;
+}
+
+Elf *
+elf_memory(char *image, size_t size)
+{
+   Elf64_Ehdr *eh = (Elf64_Ehdr *)image;
+   if (!image || size < sizeof(*eh) || memcmp(eh->e_ident, ELFMAG, SELFMAG) ||
+       eh->e_ident[EI_CLASS] != ELFCLASS64 || eh->e_shentsize != sizeof(Elf64_Shdr) ||
+       eh->e_shoff + (unsigned long long)eh->e_shnum * sizeof(Elf64_Shdr) > size) {
+      last_error = 1;
+      return NULL;
+   }
+   Elf *elf = calloc(1, sizeof(*elf));
+   if (!elf)
+      return NULL;
+   elf->image = image;
+   elf->size = size;
+   elf->ehdr = eh;
+   elf->shdrs = (Elf64_Shdr *)(image + eh->e_shoff);
+   elf->nscn = eh->e_shnum;
+   elf->scns = calloc(elf->nscn ? elf->nscn : 1, sizeof(Elf_Scn));
+   if (!elf->scns) {
+      free(elf);
+      return NULL;
+   }
+   for (size_t i = 0; i < elf->nscn; i++) {
+      Elf64_Shdr *sh = &elf->shdrs[i];
+      elf->scns[i].elf = elf;
+      elf->scns[i].index = i;
+      if (sh->sh_type != SHT_NOBITS && sh->sh_offset + sh->sh_size <= size) {
+         elf->scns[i].data.d_buf = image + sh->sh_offset;
+         elf->scns[i].data.d_size = sh->sh_size;
+      }
+      elf->scns[i].data.d_align = sh->sh_addralign;
+      elf->scns[i].data.d_version = EV_CURRENT;
+   }
+   return elf;
+}
+
+int
+elf_end(Elf *elf)
+{
+   if (elf) {
+      free(elf->scns);
+      free(elf);
+   }
+   return 0;
+}
+
+Elf_Kind
+elf_kind(Elf *elf)
+{
+   return elf ? ELF_K_ELF : ELF_K_NONE;
+}
+
+int
+elf_errno(void)
+{
+   int e = last_error;
+   last_error = 0;
+   return e;
+}
+
+const char *
+elf_errmsg(int error)
+{
+   return error ? "not a valid ELF64 image" : "no error";
+}
+
+Elf64_Ehdr *
+elf64_getehdr(Elf *elf)
+{
+   return elf ? elf->ehdr : NULL;
+}
+
+int
+elf_getshdrstrndx(Elf *elf, size_t *dst)
+{
+   if (!elf)
+      return -1;
+   *dst = elf->ehdr->e_shstrndx;
+   return 0;
+}
+
+Elf_Scn *
+elf_getscn(Elf *elf, size_t index)
+{
+   return elf && index < elf->nscn ? &elf->scns[index] : NULL;
+}
+
+Elf_Scn *
+elf_nextscn(Elf *elf, Elf_Scn *scn)
+{
+   size_t next = scn ? scn->index + 1 : 1;   /* (as libelf: section 0, the null one, is skipped) */
+   return elf_getscn(elf, next);
+}
+
+Elf64_Shdr *
+elf64_getshdr(Elf_Scn *scn)
+{
+   return scn ? &scn->elf->shdrs[scn->index] : NULL;
+}
+
+Elf_Data *
+elf_getdata(Elf_Scn *scn, Elf_Data *data)
+{
+   return scn && !data ? &scn->data : NULL;
+}
+
+char *
+elf_strptr(Elf *elf, size_t section, size_t offset)
+{
+   if (!elf || section >= elf->nscn)
+      return NULL;
+   Elf_Scn *s = &elf->scns[section];
+   if (!s->data.d_buf || offset >= s->data.d_size)
+      return NULL;
+   return (char *)s->data.d_buf + offset;
+}
--- a/src/nouveau/cubin/sieos/libelf.h
+++ b/src/nouveau/cubin/sieos/libelf.h
@@ -0,0 +1,45 @@
+/*
+ * Copyright © 2026 Olivier Moulin
+ * SPDX-License-Identifier: MIT
+ *
+ * libelf.h - SIEOS: the part of libelf's interface NVK's cubin reader uses
+ * (nv_cubin.c): an ELF64 image in memory, read only.
+ */
+#ifndef SIEOS_LIBELF_H
+#define SIEOS_LIBELF_H
+
+#include <elf.h>
+#include <stddef.h>
+
+#define EV_NONE    0
+#define EV_CURRENT 1
+
+typedef enum { ELF_K_NONE, ELF_K_AR, ELF_K_COFF, ELF_K_ELF } Elf_Kind;
+typedef enum { ELF_T_BYTE } Elf_Type;
+
+typedef struct Elf Elf;
+typedef struct Elf_Scn Elf_Scn;
+typedef struct {
+   void *d_buf;
+   Elf_Type d_type;
+   unsigned int d_version;
+   size_t d_size;
+   long long d_off;
+   size_t d_align;
+} Elf_Data;
+
+unsigned int elf_version(unsigned int version);
+Elf *elf_memory(char *image, size_t size);
+int elf_end(Elf *elf);
+Elf_Kind elf_kind(Elf *elf);
+int elf_errno(void);
+const char *elf_errmsg(int error);
+Elf64_Ehdr *elf64_getehdr(Elf *elf);
+int elf_getshdrstrndx(Elf *elf, size_t *dst);
+Elf_Scn *elf_getscn(Elf *elf, size_t index);
+Elf_Scn *elf_nextscn(Elf *elf, Elf_Scn *scn);
+Elf64_Shdr *elf64_getshdr(Elf_Scn *scn);
+Elf_Data *elf_getdata(Elf_Scn *scn, Elf_Data *data);
+char *elf_strptr(Elf *elf, size_t section, size_t offset);
+
+#endif
