# ncurses: terminal handling (libncursesw, wide characters; tic, infocmp...)
# and a terminfo database: SIEOS's own terminal ("sieos", sieos.ti: what
# facet-terminal understands) and xterm, vt100, ansi, linux, screen and dumb
# (compiled by the build host's tic, /usr/bin/tic: a directory per first letter,
# as SIEOS's ncurses reads them; conda's tic writes hexadecimal ones).  Python's curses and readline use it.
# configure: SIEOS's shared libraries are Linux's kind (its own cases,
# not libtool's: sieos* beside linux*).
name     = ncurses
version  = 6.6-2
summary  = ncurses: terminal handling (libncursesw) and terminfo, with SIEOS's terminal (TERM=sieos)
source   = https://ftpmirror.gnu.org/gnu/ncurses/ncurses-6.6.tar.gz
sha256   = 355b4cbbed880b0381a04c46617b7656e362585d52e9cf84a67e2009b749ff11
build    = sed -i -e 's/(linux\*|gnu\*/(linux*|gnu*|sieos*/' -e 's/(linux\*gnu\*|/(linux*gnu*|sieos*|/' configure
           $CONFIGURE --with-shared --without-normal --without-debug --without-ada --without-cxx-binding \
               --without-manpages --without-tests --enable-widec --disable-stripping --disable-db-install \
               --with-build-cc=gcc --enable-pc-files --with-pkg-config-libdir=$PREFIX/lib/pkgconfig \
               --with-default-terminfo-dir=$PREFIX/share/terminfo \
               --with-terminfo-dirs=$PREFIX/share/terminfo:/usr/share/terminfo
           make -j$JOBS
install  = make install DESTDIR=$DESTDIR
           mkdir -p $DESTDIR$PREFIX/share/terminfo
           T=/usr/bin/tic; [ -x $T ] || T=tic
           $T -x -o $DESTDIR$PREFIX/share/terminfo -e xterm,xterm-256color,vt100,vt220,ansi,linux,screen,dumb misc/terminfo.src
           $T -x -o $DESTDIR$PREFIX/share/terminfo $TREE/ports/pkgs/ncurses/sieos.ti
