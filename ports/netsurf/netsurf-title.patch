+/**
+ * The page's title: to the surface, as its "title" parameter (a window
+ * system's surface, such as SIEOS's Facet, shows it on the window).
+ */
+static void
+gui_window_set_title(struct gui_window *g, const char *title)
+{
+	char param[256];
+
+	snprintf(param, sizeof(param), "title=%s", title ? title : "");
+	nsfb_set_parameters(fbtk_get_nsfb(g->window), param);
+}
