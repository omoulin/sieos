+/**
+ * Whether this host has a global IPv6 address to reach the Internet with.
+ *
+ * The kernel is asked which source address it would use for a public IPv6
+ * destination (a UDP socket connected to it: nothing is sent).  Without a
+ * global one (none at all, or only link-local, site-local fec0::/10 or unique
+ * local fc00::/7 ones, as on QEMU's user network) IPv6 connections cannot
+ * succeed, and curl would first try, then wait, for every dual-stack host:
+ * the fetcher then resolves IPv4 addresses only.
+ */
+static bool fetch_curl_ipv6_global(void)
+{
+	struct sockaddr_in6 dst, src;
+	socklen_t len = sizeof(src);
+	bool global = false;
+	int s = socket(AF_INET6, SOCK_DGRAM, 0);
+
+	if (s < 0)
+		return false;
+	memset(&dst, 0, sizeof(dst));
+	dst.sin6_family = AF_INET6;
+	dst.sin6_port = htons(53);
+	inet_pton(AF_INET6, "2001:4860:4860::8888", &dst.sin6_addr);
+	if (connect(s, (struct sockaddr *)&dst, sizeof(dst)) == 0 &&
+	    getsockname(s, (struct sockaddr *)&src, &len) == 0 &&
+	    src.sin6_family == AF_INET6) {
+		const uint8_t *a = src.sin6_addr.s6_addr;
+		global = !IN6_IS_ADDR_UNSPECIFIED(&src.sin6_addr) &&
+			!IN6_IS_ADDR_LOOPBACK(&src.sin6_addr) &&
+			!IN6_IS_ADDR_V4MAPPED(&src.sin6_addr) &&
+			!(a[0] == 0xfe && (a[1] & 0x80)) &&	/* fe80::/10, fec0::/10 */
+			(a[0] & 0xfe) != 0xfc;			/* fc00::/7 */
+	}
+	close(s);
+	return global;
+}
