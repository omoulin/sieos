# /etc/rc - system startup script, run by init as root before login.
echo "SIEOS: file systems checked, starting multi-user mode."
# the interfaces' settings kept by ifconfig (/etc/network.conf)
[ -f /etc/network.conf ] && ifconfig -a
# the DNS servers learnt from DHCP and router advertisements, for the C library's resolver
ifconfig -r > /etc/resolv.conf 2>/dev/null
# the Wi-Fi network last joined, if one kept in /etc/wifi.conf is in range (in the background)
[ -f /etc/wifi.conf ] && dladm connect-wifi -q &
# the power management settings kept by poweradm (/etc/power.conf)
[ -f /etc/power.conf ] && poweradm -r
# a live system (the root in memory) started from a USB drive with a package partition
# (sieos-usb-brain.img's: sia-brain): its packages, kept on the drive, and their database
if mount | grep -q '^/dev/ramdisk on / ' && mount -L sieos-pkg /usr/pkg 2>/dev/null; then
    if [ -d /usr/pkg/.pkgdb ]; then
        rm -rf /var/lib/pkg
        /usr/gnu/bin/ln -s /usr/pkg/.pkgdb /var/lib/pkg
    fi
    echo "SIEOS: packages from the USB drive (/usr/pkg)."
fi
