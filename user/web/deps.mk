# deps.mk - WebKit's dependencies (docs/webkit-plan.md, phase 4), each built
# from its pinned release (URL and SHA-256 here; the archive fetched once into
# .hosttools/dl, never into git) into libposix's sysroot, static, for this
# processor.
#
#   make webdeps        every library below, in order
#   make webdeps-test   their checks in QEMU (tests/webdeps: our programs and a
#                       few of each library's own tests)
#
# Part of SIEOS. (c) Olivier Moulin. SPDX-License-Identifier: GPL-3.0-only

WB        := $(B)/web
SR        := $(CURDIR)/$(SYSROOT)

# ---- host tools: Meson (its wheel) and pkgconf (built by the host's gcc)
MESON_VER := 1.12.1
MESON_SHA := 930bc7542cbd9f57009e182fd014eba48cf1a0180a7b9006d2d32d8f168d8b02
MESON_URL := https://files.pythonhosted.org/packages/57/99/36cd25f9598eef70db97577440a70a360af505f6f01c2338a18d1556079c/meson-$(MESON_VER)-py3-none-any.whl
PKGCF_VER := 3.0.9
PKGCF_SHA := 6ab2d3b8087dcf500e34003a6a8934dca55d0a3d6066aeafb03c352db3e68bfd
MESON     := $(CURDIR)/$(WKT)/bin/meson
PKGCONF   := $(CURDIR)/$(WKT)/bin/pkg-config
$(WKT)/bin/meson:
	$(call fetch,$(MESON_URL),meson-$(MESON_VER).whl,$(MESON_SHA))
	rm -rf $(WKT)/meson && mkdir -p $(WKT)/bin && python3 -m zipfile -e .hosttools/dl/meson-$(MESON_VER).whl $(WKT)/meson
	printf '#!/usr/bin/env python3\nimport sys\nsys.path.insert(0, "%s")\nfrom mesonbuild.mesonmain import main\nsys.exit(main())\n' \
	    $(CURDIR)/$(WKT)/meson > $@ && chmod +x $@
$(WKT)/bin/pkg-config:
	$(call fetch,https://distfiles.ariadne.space/pkgconf/pkgconf-$(PKGCF_VER).tar.xz,pkgconf-$(PKGCF_VER).tar.xz,$(PKGCF_SHA))
	rm -rf $(WKT)/src/pkgconf-$(PKGCF_VER) && mkdir -p $(WKT)/src && tar xJf .hosttools/dl/pkgconf-$(PKGCF_VER).tar.xz -C $(WKT)/src
	cd $(WKT)/src/pkgconf-$(PKGCF_VER) && ./configure -q --prefix=$(CURDIR)/$(WKT) --disable-shared && $(MAKE) -s && $(MAKE) -s install
	rm -rf $(WKT)/src/pkgconf-$(PKGCF_VER) && ln -sf pkgconf $@

# NASM: libjpeg-turbo's x86-64 SIMD code is NASM assembly
NASM_VER  := 3.02
NASM_SHA  := 87336eba53b4acfe917424ab5d500d2b0054d9f5148d35c2273ccf2cfb712f0d
$(WKT)/bin/nasm:
	$(call fetch,https://www.nasm.us/pub/nasm/releasebuilds/$(NASM_VER)/nasm-$(NASM_VER).tar.xz,nasm-$(NASM_VER).tar.xz,$(NASM_SHA))
	rm -rf $(WKT)/src/nasm-$(NASM_VER) && mkdir -p $(WKT)/src && tar xJf .hosttools/dl/nasm-$(NASM_VER).tar.xz -C $(WKT)/src
	cd $(WKT)/src/nasm-$(NASM_VER) && ./configure -q --prefix=$(CURDIR)/$(WKT) && $(MAKE) -s nasm && cp nasm $(CURDIR)/$@
	rm -rf $(WKT)/src/nasm-$(NASM_VER)

# Bison: libxkbcommon's keymap parser is generated by it
BISON_VER := 3.8.2
BISON_SHA := 9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2
$(WKT)/bin/bison:
	$(call fetch,https://ftp.gnu.org/gnu/bison/bison-$(BISON_VER).tar.xz,bison-$(BISON_VER).tar.xz,$(BISON_SHA))
	rm -rf $(WKT)/src/bison-$(BISON_VER) && mkdir -p $(WKT)/src && tar xJf .hosttools/dl/bison-$(BISON_VER).tar.xz -C $(WKT)/src
	cd $(WKT)/src/bison-$(BISON_VER) && ./configure -q --prefix=$(CURDIR)/$(WKT) --disable-nls && $(MAKE) -s && $(MAKE) -s install
	rm -rf $(WKT)/src/bison-$(BISON_VER)

# ---- the cross toolchain: compiler wrappers (clang for this processor, the
# sysroot, compiler-rt's builtins and crtbegin/crtend, static, lld with the
# segment layout SIEOS's loader wants), a CMake toolchain file, a Meson cross file
CLANG     := $(CURDIR)/$(LLVM)/bin/clang
WCFLAGS   := --target=$(TRIPLE) --sysroot=$(SR) -resource-dir=$(CURDIR)/$(WB)/resource -static -rtlib=compiler-rt \
             -unwindlib=libunwind -fuse-ld=lld -Qunused-arguments -ffunction-sections -fdata-sections \
             -Wl,-z,separate-loadable-segments -Wl,-z,max-page-size=4096 -Wl,--gc-sections -Wl,--eh-frame-hdr
$(WB)/toolchain.stamp: $(SYSROOT)/usr/lib/crti.o | $(SYSROOT)/usr/lib/libc++.a $(WKT)/bin/meson $(WKT)/bin/pkg-config $(WKT)/bin/cmake $(WKT)/bin/ninja
	mkdir -p $(WB)/bin $(WB)/resource/lib $(WB)/stamp $(WB)/src $(WB)/build
	ln -sfn $(CURDIR)/$(LLVM)/lib/clang/23/include $(WB)/resource/include
	ln -sfn $(SR)/usr/lib/linux $(WB)/resource/lib/linux
	printf '#!/bin/sh\nexec %s %s "$$@"\n' $(CLANG) "$(WCFLAGS)" > $(WB)/bin/cc
	printf '#!/bin/sh\nexec %s++ %s -stdlib=libc++ "$$@"\n' $(CLANG) "$(WCFLAGS)" > $(WB)/bin/c++
	chmod +x $(WB)/bin/cc $(WB)/bin/c++
	printf 'set(CMAKE_SYSTEM_NAME Linux)\nset(CMAKE_SYSTEM_PROCESSOR %s)\nset(CMAKE_SYSROOT %s)\n' $(MARCH) $(SR) > $(WB)/toolchain.cmake
	printf 'set(CMAKE_C_COMPILER %s/bin/cc)\nset(CMAKE_CXX_COMPILER %s/bin/c++)\n' $(CURDIR)/$(WB) $(CURDIR)/$(WB) >> $(WB)/toolchain.cmake
	printf 'set(CMAKE_AR %s/bin/llvm-ar)\nset(CMAKE_RANLIB %s/bin/llvm-ranlib)\nset(BUILD_SHARED_LIBS OFF)\n' $(CURDIR)/$(LLVM) $(CURDIR)/$(LLVM) >> $(WB)/toolchain.cmake
	printf 'set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)\nset(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)\nset(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)\nset(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)\n' >> $(WB)/toolchain.cmake
	printf "[binaries]\nc = '%s/bin/cc'\ncpp = '%s/bin/c++'\nar = '%s/bin/llvm-ar'\nstrip = '%s/bin/llvm-strip'\npkg-config = '%s'\n" \
	    $(CURDIR)/$(WB) $(CURDIR)/$(WB) $(CURDIR)/$(LLVM) $(CURDIR)/$(LLVM) $(PKGCONF) > $(WB)/cross.txt
	printf "[properties]\nsys_root = '%s'\npkg_config_libdir = '%s/usr/lib/pkgconfig:%s/usr/share/pkgconfig'\nneeds_exe_wrapper = true\n" $(SR) $(SR) $(SR) >> $(WB)/cross.txt
	printf "[host_machine]\nsystem = 'linux'\ncpu_family = '%s'\ncpu = '%s'\nendian = 'little'\n" $(MARCH) $(MARCH) >> $(WB)/cross.txt
	touch $@

# How each build system is run. Libraries are static, small (-Os), their
# programs and documentation left out where the build allows it.
PKGENV    := PATH=$(CURDIR)/$(WKT)/bin:$$PATH PKG_CONFIG=$(PKGCONF) PKG_CONFIG_LIBDIR=$(SR)/usr/lib/pkgconfig:$(SR)/usr/share/pkgconfig PKG_CONFIG_SYSROOT_DIR=$(SR)
CONFIGURE := $(PKGENV) CC=$(CURDIR)/$(WB)/bin/cc CXX=$(CURDIR)/$(WB)/bin/c++ AR=$(CURDIR)/$(LLVM)/bin/llvm-ar \
             RANLIB=$(CURDIR)/$(LLVM)/bin/llvm-ranlib CFLAGS=-Os CXXFLAGS=-Os ./configure --host=$(TRIPLE) --prefix=/usr \
             --disable-shared --enable-static
MESONSET  := $(PKGENV) $(MESON) setup --cross-file $(CURDIR)/$(WB)/cross.txt --prefix=/usr --libdir=lib \
             --buildtype=minsize -Ddefault_library=static -Db_staticpic=false -Db_ndebug=if-release --wrap-mode=nofallback
CMAKESET  := $(CMAKE) -G Ninja -DCMAKE_MAKE_PROGRAM=$(NINJA) -DCMAKE_TOOLCHAIN_FILE=$(CURDIR)/$(WB)/toolchain.cmake \
             -DCMAKE_BUILD_TYPE=MinSizeRel -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib
# $(call unpack,NAME,ARCHIVE): a fresh copy of its sources in $(WB)/src/NAME
unpack = rm -rf $(WB)/src/$(1) && mkdir -p $(WB)/src/$(1) && tar xf .hosttools/dl/$(2) -C $(WB)/src/$(1) --strip-components=1
# (libtool's .la files point at /usr/lib: not wanted in a sysroot)
nola   = find $(SR)/usr/lib -name '*.la' -delete

# ---- zlib
ZLIB_VER  := 1.3.2
ZLIB_SHA  := d7a0654783a4da529d1bb793b7ad9c3318020af77667bcae35f95d0e42a792f3
$(WB)/stamp/zlib: $(WB)/toolchain.stamp
	$(call fetch,https://zlib.net/zlib-$(ZLIB_VER).tar.xz,zlib-$(ZLIB_VER).tar.xz,$(ZLIB_SHA))
	$(call unpack,zlib,zlib-$(ZLIB_VER).tar.xz)
	cd $(WB)/src/zlib && CC=$(CURDIR)/$(WB)/bin/cc AR=$(CURDIR)/$(LLVM)/bin/llvm-ar CFLAGS=-Os ./configure --static --prefix=/usr >/dev/null
	$(MAKE) -s -C $(WB)/src/zlib libz.a example && $(MAKE) -s -C $(WB)/src/zlib install DESTDIR=$(SR) >/dev/null
	touch $@
$(WB)/wtest-zlib-example: $(WB)/stamp/zlib             # (zlib's own test)
	cp $(WB)/src/zlib/example $@

# ---- libffi (GObject's generic marshaller)
FFI_VER   := 3.8.0
FFI_SHA   := 7da3e2d9a171eb0a038f592ecad3ff2bb2550f3496d87b3b29ad0cf4430c0db4
$(WB)/stamp/libffi: $(WB)/toolchain.stamp
	$(call fetch,https://github.com/libffi/libffi/releases/download/v$(FFI_VER)/libffi-$(FFI_VER).tar.gz,libffi-$(FFI_VER).tar.gz,$(FFI_SHA))
	$(call unpack,libffi,libffi-$(FFI_VER).tar.gz)
	cd $(WB)/src/libffi && $(CONFIGURE) --disable-docs --disable-multi-os-directory --disable-exec-static-tramp >/dev/null
	$(MAKE) -s -C $(WB)/src/libffi && $(MAKE) -s -C $(WB)/src/libffi install DESTDIR=$(SR) >/dev/null && $(nola)
	touch $@

# ---- PCRE2 (GLib's regular expressions), 8-bit, no JIT
PCRE2_VER := 10.49
PCRE2_SHA := 53c156e1ba416a20da8e65395daa132da0d80e76910424caca3fcdae7831d384
$(WB)/stamp/pcre2: $(WB)/toolchain.stamp
	$(call fetch,https://github.com/PCRE2Project/pcre2/releases/download/pcre2-$(PCRE2_VER)/pcre2-$(PCRE2_VER).tar.bz2,pcre2-$(PCRE2_VER).tar.bz2,$(PCRE2_SHA))
	$(call unpack,pcre2,pcre2-$(PCRE2_VER).tar.bz2)
	cd $(WB)/src/pcre2 && $(CONFIGURE) --disable-pcre2grep-libz --disable-pcre2grep-libbz2 --disable-pcre2test-libreadline >/dev/null
	$(MAKE) -s -C $(WB)/src/pcre2 libpcre2-8.la && $(MAKE) -s -C $(WB)/src/pcre2 install-libLTLIBRARIES install-includeHEADERS \
	    install-nodist_includeHEADERS install-pkgconfigDATA DESTDIR=$(SR) >/dev/null && $(nola)
	touch $@

# ---- GLib (GLib, GObject, GIO): WPE's own base
GLIB_VER  := 2.90.1
GLIB_SHA  := 93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396
$(WB)/stamp/glib: $(WB)/stamp/zlib $(WB)/stamp/libffi $(WB)/stamp/pcre2
	$(call fetch,https://download.gnome.org/sources/glib/$(basename $(GLIB_VER))/glib-$(GLIB_VER).tar.xz,glib-$(GLIB_VER).tar.xz,$(GLIB_SHA))
	$(call unpack,glib,glib-$(GLIB_VER).tar.xz)
	rm -rf $(WB)/build/glib && cd $(WB)/src/glib && $(MESONSET) $(CURDIR)/$(WB)/build/glib -Dtests=false \
	    -Dintrospection=disabled -Dlibmount=disabled -Dselinux=disabled -Dxattr=false -Dman-pages=disabled \
	    -Dnls=disabled -Ddtrace=disabled -Dsystemtap=disabled -Dsysprof=disabled -Dlibelf=disabled \
	    -Ddocumentation=false -Dbsymbolic_functions=false -Dglib_debug=disabled >/dev/null
	$(PKGENV) $(NINJA) -C $(WB)/build/glib
	$(PKGENV) $(MESON) install -C $(WB)/build/glib --destdir $(SR) --no-rebuild | tail -3
	touch $@

# ---- ICU (text: Unicode properties, normalization, breaking, collation, Intl).
# Its data is built from source, filtered (user/web/icu-filter.json), by the
# tools of a host build of the same ICU, and linked in (static data).
ICU_VER   := 78.3
ICU_SHA   := 3a2e7a47604ba702f345878308e6fefeca612ee895cf4a5f222e7955fabfe0c0
ICUD_SHA  := 9d8b3899096aeb83e4e21ef8a40fec9e03b28db18c48452efac882ce25a91e27
ICU_URL   := https://github.com/unicode-org/icu/releases/download/release-$(ICU_VER)
ICU_OFF   := --disable-tests --disable-samples --disable-extras --disable-icuio --disable-layoutex
$(WB)/stamp/icu: $(WB)/toolchain.stamp user/web/icu-filter.json
	$(call fetch,$(ICU_URL)/icu4c-$(ICU_VER)-sources.tgz,icu4c-$(ICU_VER)-sources.tgz,$(ICU_SHA))
	$(call fetch,$(ICU_URL)/icu4c-$(ICU_VER)-data.zip,icu4c-$(ICU_VER)-data.zip,$(ICUD_SHA))
	$(call unpack,icu,icu4c-$(ICU_VER)-sources.tgz)
	rm -rf $(WB)/src/icu/source/data && cd $(WB)/src/icu/source && python3 -m zipfile -e $(CURDIR)/.hosttools/dl/icu4c-$(ICU_VER)-data.zip .
	rm -rf $(WB)/build/icu-host $(WB)/build/icu && mkdir -p $(WB)/build/icu-host $(WB)/build/icu
	cd $(WB)/build/icu-host && ICU_DATA_FILTER_FILE=$(CURDIR)/user/web/icu-filter.json CC=gcc CXX=g++ \
	    $(CURDIR)/$(WB)/src/icu/source/configure $(ICU_OFF) >/dev/null && $(MAKE) -s >/dev/null
	cd $(WB)/build/icu && ICU_DATA_FILTER_FILE=$(CURDIR)/user/web/icu-filter.json $(PKGENV) CC=$(CURDIR)/$(WB)/bin/cc \
	    CXX=$(CURDIR)/$(WB)/bin/c++ AR=$(CURDIR)/$(LLVM)/bin/llvm-ar RANLIB=$(CURDIR)/$(LLVM)/bin/llvm-ranlib CFLAGS=-Os CXXFLAGS=-Os \
	    $(CURDIR)/$(WB)/src/icu/source/configure --host=$(TRIPLE) --prefix=/usr --with-cross-build=$(CURDIR)/$(WB)/build/icu-host \
	    --disable-shared --enable-static --with-data-packaging=static --disable-tools $(ICU_OFF) >/dev/null
	$(MAKE) -s -C $(WB)/build/icu >/dev/null && $(MAKE) -s -C $(WB)/build/icu install DESTDIR=$(SR) >/dev/null
	touch $@

# ---- FreeType (glyphs; PNG for colour bitmaps (emoji); no Brotli, no HarfBuzz)
FT_VER    := 2.15.0
FT_SHA    := 93cd47eb719c325107f2d3cf087d06299e944c3b48a40b55537302304dea1dd5
$(WB)/stamp/freetype: $(WB)/stamp/zlib $(WB)/stamp/libpng
	$(call fetch,https://download.savannah.gnu.org/releases/freetype/freetype-$(FT_VER).tar.xz,freetype-$(FT_VER).tar.xz,$(FT_SHA))
	$(call unpack,freetype,freetype-$(FT_VER).tar.xz)
	rm -rf $(WB)/build/freetype && cd $(WB)/src/freetype && $(MESONSET) $(CURDIR)/$(WB)/build/freetype -Dbrotli=disabled \
	    -Dbzip2=disabled -Dharfbuzz=disabled -Dpng=enabled -Dzlib=enabled -Dtests=disabled >/dev/null
	$(PKGENV) $(NINJA) -C $(WB)/build/freetype >/dev/null && $(PKGENV) $(MESON) install -C $(WB)/build/freetype --destdir $(SR) --no-rebuild >/dev/null
	touch $@

# ---- HarfBuzz (shaping), with ICU and FreeType; no GLib, Cairo, subsetter, tools
HB_VER    := 14.6.0
HB_SHA    := d07a007327277708a2a73ae437887cdbaf282937f6d03ca5467723e9099af586
HB_OFF    := glib gobject cairo chafa png zlib graphite graphite2 fontations harfrust kbts wasm raster vector gpu subset \
             tests introspection docs utilities benchmark
$(WB)/stamp/harfbuzz: $(WB)/stamp/icu $(WB)/stamp/freetype
	$(call fetch,https://github.com/harfbuzz/harfbuzz/releases/download/$(HB_VER)/harfbuzz-$(HB_VER).tar.xz,harfbuzz-$(HB_VER).tar.xz,$(HB_SHA))
	$(call unpack,harfbuzz,harfbuzz-$(HB_VER).tar.xz)
	rm -rf $(WB)/build/harfbuzz && cd $(WB)/src/harfbuzz && $(MESONSET) $(CURDIR)/$(WB)/build/harfbuzz -Dicu=enabled \
	    -Dfreetype=enabled $(HB_OFF:%=-D%=disabled) >/dev/null
	$(PKGENV) $(NINJA) -C $(WB)/build/harfbuzz >/dev/null && $(PKGENV) $(MESON) install -C $(WB)/build/harfbuzz --destdir $(SR) --no-rebuild >/dev/null
	touch $@

# ---- Expat (Fontconfig's XML)
EXPAT_VER := 2.9.0
EXPAT_SHA := 1e6371862cc31999b368c3b89b49994f0677e1bab5f1b2b85ae3741f5d803051
$(WB)/stamp/expat: $(WB)/toolchain.stamp
	$(call fetch,https://github.com/libexpat/libexpat/releases/download/R_$(subst .,_,$(EXPAT_VER))/expat-$(EXPAT_VER).tar.xz,expat-$(EXPAT_VER).tar.xz,$(EXPAT_SHA))
	$(call unpack,expat,expat-$(EXPAT_VER).tar.xz)
	rm -rf $(WB)/build/expat && $(CMAKESET) -S $(WB)/src/expat -B $(WB)/build/expat -DEXPAT_BUILD_TOOLS=OFF -DEXPAT_BUILD_EXAMPLES=OFF \
	    -DEXPAT_BUILD_TESTS=OFF -DEXPAT_BUILD_DOCS=OFF -DEXPAT_SHARED_LIBS=OFF >/dev/null
	$(NINJA) -C $(WB)/build/expat >/dev/null && DESTDIR=$(SR) $(NINJA) -C $(WB)/build/expat install >/dev/null
	touch $@

# ---- Fontconfig (finding fonts: Skia and WebCore ask it); its configuration in /etc/fonts
FC_VER    := 2.18.3
FC_SHA    := 4f7b554a38cdf78c033f666c8871f3749e14a094f65a07f630c91ed0b43d35e3
$(WB)/stamp/fontconfig: $(WB)/stamp/freetype $(WB)/stamp/expat
	$(call fetch,https://gitlab.freedesktop.org/api/v4/projects/890/packages/generic/fontconfig/$(FC_VER)/fontconfig-$(FC_VER).tar.xz,fontconfig-$(FC_VER).tar.xz,$(FC_SHA))
	$(call unpack,fontconfig,fontconfig-$(FC_VER).tar.xz)
	rm -rf $(WB)/build/fontconfig && cd $(WB)/src/fontconfig && $(MESONSET) $(CURDIR)/$(WB)/build/fontconfig -Dsysconfdir=/etc \
	    -Dlocalstatedir=/var -Ddoc=disabled -Dnls=disabled -Dtests=disabled -Dtools=disabled -Dcache-build=disabled \
	    -Diconv=disabled -Dxml-backend=expat -Dfontations=disabled -Ddefault-fonts-dirs=/lib/fonts >/dev/null
	$(PKGENV) $(NINJA) -C $(WB)/build/fontconfig >/dev/null && $(PKGENV) $(MESON) install -C $(WB)/build/fontconfig --destdir $(SR) --no-rebuild >/dev/null
	touch $@

# ---- fonts for the tests (and, later, the browser): DejaVu
DJV_VER   := 2.37
DJV_SHA   := fa9ca4d13871dd122f61258a80d01751d603b4d3ee14095d65453b4e846e17d7
DJV_FONTS := DejaVuSans DejaVuSans-Bold DejaVuSerif DejaVuSansMono
$(WB)/fonts/DejaVuSans.ttf: user/web/deps.mk
	$(call fetch,https://github.com/dejavu-fonts/dejavu-fonts/releases/download/version_$(subst .,_,$(DJV_VER))/dejavu-fonts-ttf-$(DJV_VER).tar.bz2,dejavu-fonts-ttf-$(DJV_VER).tar.bz2,$(DJV_SHA))
	mkdir -p $(@D) && tar xjf .hosttools/dl/dejavu-fonts-ttf-$(DJV_VER).tar.bz2 -C $(@D) --strip-components=2 \
	    $(DJV_FONTS:%=dejavu-fonts-ttf-$(DJV_VER)/ttf/%.ttf) && touch $@

# ---- libpng (with its SIMD filters)
PNG_VER   := 1.6.59
PNG_SHA   := d80dd2a38a37f803cb9b6ac7b14bd6e74ddc3b654780a8380bdf93523fdb4389
$(WB)/stamp/libpng: $(WB)/stamp/zlib
	$(call fetch,https://download.sourceforge.net/libpng/libpng-$(PNG_VER).tar.xz,libpng-$(PNG_VER).tar.xz,$(PNG_SHA))
	$(call unpack,libpng,libpng-$(PNG_VER).tar.xz)
	rm -rf $(WB)/build/libpng && $(CMAKESET) -S $(WB)/src/libpng -B $(WB)/build/libpng -DPNG_SHARED=OFF -DPNG_STATIC=ON \
	    -DPNG_TESTS=OFF -DPNG_TOOLS=OFF -DPNG_EXECUTABLES=OFF -DPNG_FRAMEWORK=OFF >/dev/null
	$(NINJA) -C $(WB)/build/libpng >/dev/null && DESTDIR=$(SR) $(NINJA) -C $(WB)/build/libpng install >/dev/null
	touch $@

# ---- libjpeg-turbo (the JPEG API; its SIMD code: NASM on x86-64, intrinsics on arm64)
JPEG_VER  := 3.2.0
JPEG_SHA  := 6f30092cef9fb839779646608f4ee14ae3cbac989c47fa05e841b0841f09878e
$(WB)/stamp/libjpeg: $(WB)/toolchain.stamp | $(WKT)/bin/nasm
	$(call fetch,https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/$(JPEG_VER)/libjpeg-turbo-$(JPEG_VER).tar.gz,libjpeg-turbo-$(JPEG_VER).tar.gz,$(JPEG_SHA))
	$(call unpack,libjpeg,libjpeg-turbo-$(JPEG_VER).tar.gz)
	rm -rf $(WB)/build/libjpeg && $(CMAKESET) -S $(WB)/src/libjpeg -B $(WB)/build/libjpeg -DENABLE_SHARED=OFF -DENABLE_STATIC=ON \
	    -DWITH_TURBOJPEG=OFF -DWITH_TOOLS=OFF -DWITH_TESTS=OFF -DWITH_SIMD=ON -DREQUIRE_SIMD=ON \
	    -DCMAKE_ASM_NASM_COMPILER=$(CURDIR)/$(WKT)/bin/nasm >/dev/null
	$(NINJA) -C $(WB)/build/libjpeg >/dev/null && DESTDIR=$(SR) $(NINJA) -C $(WB)/build/libjpeg install >/dev/null
	touch $@

# ---- libwebp (decoding, demux; the encoder comes with it; no tools)
WEBP_VER  := 1.6.0
WEBP_SHA  := e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564
WEBP_OFF  := ANIM_UTILS CWEBP DWEBP GIF2WEBP IMG2WEBP VWEBP WEBPINFO WEBPMUX EXTRAS WEBP_JS FUZZTEST
$(WB)/stamp/libwebp: $(WB)/toolchain.stamp
	$(call fetch,https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-$(WEBP_VER).tar.gz,libwebp-$(WEBP_VER).tar.gz,$(WEBP_SHA))
	$(call unpack,libwebp,libwebp-$(WEBP_VER).tar.gz)
	rm -rf $(WB)/build/libwebp && $(CMAKESET) -S $(WB)/src/libwebp -B $(WB)/build/libwebp $(WEBP_OFF:%=-DWEBP_BUILD_%=OFF) \
	    -DWEBP_BUILD_LIBWEBPMUX=ON -DWEBP_USE_THREAD=ON >/dev/null
	$(NINJA) -C $(WB)/build/libwebp >/dev/null && DESTDIR=$(SR) $(NINJA) -C $(WB)/build/libwebp install >/dev/null
	touch $@

# ---- SQLite (cookies, storage): the amalgamation, one C file. No loadable
# extensions, no deprecated calls; WAL without shared memory between
# processes (exclusive locking: one process owns a database, as in WebKit)
SQLITE_VER := 3540100
SQLITE_SHA := 0a9c8e34352dad46006aa82836d5383bff9dc6bc9ce5a60553c05aa30e6ad1f9
SQLITE_DEF := -DSQLITE_THREADSAFE=1 -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_OMIT_DEPRECATED -DSQLITE_DQS=0 \
              -DSQLITE_DEFAULT_MEMSTATUS=0 -DSQLITE_DEFAULT_LOCKING_MODE=1
$(WB)/stamp/sqlite: $(WB)/toolchain.stamp
	$(call fetch,https://www.sqlite.org/2026/sqlite-amalgamation-$(SQLITE_VER).zip,sqlite-amalgamation-$(SQLITE_VER).zip,$(SQLITE_SHA))
	rm -rf $(WB)/src/sqlite && mkdir -p $(WB)/src && python3 -m zipfile -e .hosttools/dl/sqlite-amalgamation-$(SQLITE_VER).zip $(WB)/src && \
	    mv $(WB)/src/sqlite-amalgamation-$(SQLITE_VER) $(WB)/src/sqlite
	$(WB)/bin/cc -Os $(SQLITE_DEF) -c $(WB)/src/sqlite/sqlite3.c -o $(WB)/src/sqlite/sqlite3.o
	rm -f $(SR)/usr/lib/libsqlite3.a && $(LLVM)/bin/llvm-ar rcs $(SR)/usr/lib/libsqlite3.a $(WB)/src/sqlite/sqlite3.o
	cp $(WB)/src/sqlite/sqlite3.h $(WB)/src/sqlite/sqlite3ext.h $(SR)/usr/include/
	printf 'prefix=/usr\nlibdir=$${prefix}/lib\nincludedir=$${prefix}/include\nName: SQLite\nDescription: SQL database engine\nVersion: %s\nLibs: -L$${libdir} -lsqlite3\nCflags: -I$${includedir}\n' \
	    $(SQLITE_VER) > $(SR)/usr/lib/pkgconfig/sqlite3.pc
	touch $@

# ---- libxml2 (WebCore's XML): no Python, ICU, zlib, LZMA, HTTP, catalogs, programs
XML_VER   := 2.15.4
XML_SHA   := 98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821
XML_OFF   := PYTHON ICU ZLIB HTTP CATALOG DEBUG DOCS HISTORY LEGACY MODULES PROGRAMS READLINE SCHEMATRON TESTS
$(WB)/stamp/libxml2: $(WB)/toolchain.stamp
	$(call fetch,https://download.gnome.org/sources/libxml2/$(basename $(XML_VER))/libxml2-$(XML_VER).tar.xz,libxml2-$(XML_VER).tar.xz,$(XML_SHA))
	$(call unpack,libxml2,libxml2-$(XML_VER).tar.xz)
	rm -rf $(WB)/build/libxml2 && $(CMAKESET) -S $(WB)/src/libxml2 -B $(WB)/build/libxml2 $(XML_OFF:%=-DLIBXML2_WITH_%=OFF) >/dev/null
	$(NINJA) -C $(WB)/build/libxml2 >/dev/null && DESTDIR=$(SR) $(NINJA) -C $(WB)/build/libxml2 install >/dev/null
	touch $@

# ---- libgpg-error and libgcrypt (WebCrypto, hashes), with their assembly
GPGE_VER  := 1.61
GPGE_SHA  := 7a85413f2bc354f4f8aa832b718af122e48965e9e0eb9012ee659c13c6385c93
GCRY_VER  := 1.12.4
GCRY_SHA  := d77f68f48879510e79a2f65977ccc68981781ea0923e5bdffac2a193ea3d660e
$(WB)/stamp/libgpg-error: $(WB)/toolchain.stamp
	$(call fetch,https://www.gnupg.org/ftp/gcrypt/libgpg-error/libgpg-error-$(GPGE_VER).tar.bz2,libgpg-error-$(GPGE_VER).tar.bz2,$(GPGE_SHA))
	$(call unpack,libgpg-error,libgpg-error-$(GPGE_VER).tar.bz2)
	cd $(WB)/src/libgpg-error && $(CONFIGURE) --disable-doc --disable-tests --disable-nls --disable-languages >/dev/null
	$(MAKE) -s -C $(WB)/src/libgpg-error >/dev/null && $(MAKE) -s -C $(WB)/src/libgpg-error install DESTDIR=$(SR) >/dev/null && $(nola)
	touch $@
$(WB)/stamp/libgcrypt: $(WB)/stamp/libgpg-error
	$(call fetch,https://www.gnupg.org/ftp/gcrypt/libgcrypt/libgcrypt-$(GCRY_VER).tar.bz2,libgcrypt-$(GCRY_VER).tar.bz2,$(GCRY_SHA))
	$(call unpack,libgcrypt,libgcrypt-$(GCRY_VER).tar.bz2)
	cd $(WB)/src/libgcrypt && GPGRT_CONFIG="$(SR)/usr/bin/gpgrt-config --libdir=$(SR)/usr/lib" $(CONFIGURE) --disable-doc --disable-padlock-support \
	    --disable-jent-support --enable-ciphers=aes --enable-pubkey-ciphers="rsa ecc" --enable-digests="sha1 sha256 sha512 sha3" \
	    --enable-kfds=pkdf2 >/dev/null
	$(MAKE) -s -C $(WB)/src/libgcrypt SUBDIRS="compat mpi cipher random src" >/dev/null && \
	    $(MAKE) -s -C $(WB)/src/libgcrypt/src install DESTDIR=$(SR) >/dev/null && $(nola)
	touch $@

# ---- libtasn1 (WebCrypto's key formats)
TASN_VER  := 4.21.0
TASN_SHA  := 1d8a444a223cc5464240777346e125de51d8e6abf0b8bac742ac84609167dc87
$(WB)/stamp/libtasn1: $(WB)/toolchain.stamp
	$(call fetch,https://ftp.gnu.org/gnu/libtasn1/libtasn1-$(TASN_VER).tar.gz,libtasn1-$(TASN_VER).tar.gz,$(TASN_SHA))
	$(call unpack,libtasn1,libtasn1-$(TASN_VER).tar.gz)
	cd $(WB)/src/libtasn1 && $(CONFIGURE) --disable-doc --disable-valgrind-tests >/dev/null
	$(MAKE) -s -C $(WB)/src/libtasn1/lib >/dev/null && $(MAKE) -s -C $(WB)/src/libtasn1/lib install DESTDIR=$(SR) >/dev/null && $(nola)
	touch $@

# ---- Khronos's EGL and OpenGL ES headers (WebKit includes them, libepoxy
# needs them), as Mesa's release ships them: only the headers are kept
MESA_VER  := 26.2.5
MESA_SHA  := 794b3d1729075dae7ebd47c7283b7ca0cdb5dec668f7f11cc0a5d82f6138a0a5
$(WB)/stamp/khronos: $(WB)/toolchain.stamp
	$(call fetch,https://archive.mesa3d.org/mesa-$(MESA_VER).tar.xz,mesa-$(MESA_VER).tar.xz,$(MESA_SHA))
	tar xJf .hosttools/dl/mesa-$(MESA_VER).tar.xz -C $(SR)/usr/include --strip-components=2 \
	    $(foreach d,EGL GLES2 GLES3 KHR,mesa-$(MESA_VER)/include/$(d))
	touch $@

# ---- libepoxy: WebKit's GL calls go through it. No GL on SIEOS yet (Skia on
# the CPU): WebKit's build requires it, and at run time it finds no GL
EPOXY_VER := 1.5.10
EPOXY_SHA := 072cda4b59dd098bba8c2363a6247299db1fa89411dc221c8b81b8ee8192e623
$(WB)/stamp/libepoxy: $(WB)/stamp/khronos
	$(call fetch,https://download.gnome.org/sources/libepoxy/$(basename $(EPOXY_VER))/libepoxy-$(EPOXY_VER).tar.xz,libepoxy-$(EPOXY_VER).tar.xz,$(EPOXY_SHA))
	$(call unpack,libepoxy,libepoxy-$(EPOXY_VER).tar.xz)
	rm -rf $(WB)/build/libepoxy && cd $(WB)/src/libepoxy && $(MESONSET) $(CURDIR)/$(WB)/build/libepoxy -Ddocs=false -Dglx=no \
	    -Degl=yes -Dx11=false -Dtests=false -Dc_args=-DEGL_NO_X11 >/dev/null
	$(PKGENV) $(NINJA) -C $(WB)/build/libepoxy >/dev/null && $(PKGENV) $(MESON) install -C $(WB)/build/libepoxy --destdir $(SR) --no-rebuild >/dev/null
	touch $@

# ---- libxkbcommon: key symbols and their characters (WebKit's key events,
# WPEPlatform's keymap). No X11, Wayland, keymap files, tools: SIEOS's
# platform gives its keymap itself
XKB_VER   := 1.13.2
XKB_SHA   := acc4d5f7c3cbba5f9f8d08d8bdbeede84ecede46792f47929aa9321873385528
$(WB)/stamp/libxkbcommon: $(WB)/toolchain.stamp | $(WKT)/bin/bison
	$(call fetch,https://github.com/xkbcommon/libxkbcommon/archive/refs/tags/xkbcommon-$(XKB_VER).tar.gz,libxkbcommon-$(XKB_VER).tar.gz,$(XKB_SHA))
	$(call unpack,libxkbcommon,libxkbcommon-$(XKB_VER).tar.gz)
	rm -rf $(WB)/build/libxkbcommon && cd $(WB)/src/libxkbcommon && $(MESONSET) $(CURDIR)/$(WB)/build/libxkbcommon \
	    -Denable-x11=false -Denable-wayland=false -Denable-docs=false -Denable-tools=false -Denable-xkbregistry=false \
	    -Denable-bash-completion=false -Dxkb-config-root=/lib/xkb -Dx-locale-root=/lib/xkb/locale >/dev/null
	$(PKGENV) $(NINJA) -C $(WB)/build/libxkbcommon libxkbcommon.a >/dev/null && \
	    $(PKGENV) $(MESON) install -C $(WB)/build/libxkbcommon --destdir $(SR) --no-rebuild >/dev/null   # (its tests: not built)
	touch $@

# ---- libpsl: the public suffix list (which part of a name is a site, for
