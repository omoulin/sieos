// vkcompute's shader: out[i] = in[i] * in[i]
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { float v[]; } inbuf;
layout(std430, binding = 1) writeonly buffer Out { float v[]; } outbuf;
layout(push_constant) uniform P { uint n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.n)
        outbuf.v[i] = inbuf.v[i] * inbuf.v[i];
}
